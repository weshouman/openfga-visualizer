# User source: "keycloak", "ldap", or "static" (default)
USER_SOURCE=static

# Keycloak settings (when USER_SOURCE=keycloak)
KEYCLOAK_BASE_URL=http://host.docker.internal:18080
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# LDAP settings (when USER_SOURCE=ldap)
LDAP_URL=ldaps://localhost:636
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(objectClass=inetOrgPerson)
LDAP_USER_ATTR=uid
LDAP_TLS_VERIFY=true

# OpenFGA model file
OPENFGA_MODEL_FILE=config/default.json
PROJECT_DATA_FILE=config/project-data.json

# Flask
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Host port mapping
VISUALIZER_HTTP_PORT=5090
